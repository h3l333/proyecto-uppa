@startuml Diagrama_Comunicacion_CU04
allowmixing
' Diagrama de comunicacion - CU-04 Consultar Seguimiento de Practica
' PlantUML no tiene un renderer nativo para diagramas de comunicacion UML,
' por lo que se representa como diagrama de objetos: un enlace (linea) por
' cada par de participantes que interactuan, con nota adjunta listando los
' mensajes numerados intercambiados en ese enlace (orden = secuencia UML).
' Numeracion sincronizada con diagrama-de-secuencia-cu-04.puml.
hide circle
skinparam object {
  BackgroundColor #ADD1E6
  BorderColor #2C3E50
}

object ": InterfazConsultaDePractica" as Interfaz
object ": GestorConsultaDePractica" as Gestor
object ": InformeDeAvance" as InformeAvance
object ": Responsable" as Responsable
object ": Actor" as ActorEntidad
object ": Practica" as Practica

actor "Tutor / Responsable de Empresa" as Actor

Actor -- Interfaz
Interfaz -- Gestor
Gestor -- InformeAvance
Gestor -- Responsable
Gestor -- ActorEntidad
Gestor -- Practica

note on link
  1: iniciarConsulta()
  9: ingresarFiltros()
  18: seleccionarPractica()
end note

note on link
  2: validarCredenciales()
  7: retornarDatosActor()
  8: refrescarInterfaz()
  10: buscarPracticas()
  15: filtrarPracticas()
  16: devolverPracticasFiltradas()
  19: buscarDataResponsable()
  24: buscarDataInforme()
  28: retornarDataResponsable()
  29: retornarDataInforme()
  31: mostrarDetallePractica()
end note

note on link
  25: buscarDataInforme()
end note

note on link
  20: buscarDataResponsable()
end note

note on link
  3: buscarDatosActor()
end note

note on link
  11: buscarPracticas()
end note

@enduml
