@startuml
title CU-02 - Generar Informe de Avance

|Tutor / Responsable de Empresa|
start
:Acceder a "Generar Informe de Avance";

|Sistema|
:Mostrar listado de prácticas
bajo su seguimiento;

|Tutor / Responsable de Empresa|
:Seleccionar una práctica;

|Sistema|
:Verificar que la práctica se encuentre
en seguimiento operativo;

if (¿Práctica en seguimiento operativo?) then (Sí)
  :Mostrar formulario del informe;
else (No)
  :Informar que la práctica
  no se encuentra en curso;
  stop
endif

|Tutor / Responsable de Empresa|
:Ingresar fecha del informe;

|Sistema|
if (¿Fecha dentro del período de práctica?) then (Sí)
else (No)
  :Informar que la fecha del informe
  no es válida;
  
  |Tutor / Responsable de Empresa|
  :Corregir la fecha;
  
  |Sistema|
  if (¿Fecha dentro del período de práctica?) then (Sí)
  else (No)
    :Informar que la fecha del informe
    no es válida;
    stop
  endif
endif

|Tutor / Responsable de Empresa|
:Ingresar descripción de las tareas realizadas;
:Ingresar evaluación parcial;
:Confirmar operación;

|Sistema|
:Validar datos obligatorios;

if (¿Datos obligatorios completos?) then (Sí)
  :Registrar informe de avance;
  :Vincular informe con la práctica;
  :Actualizar seguimiento de la práctica;
  :Informar que el registro fue exitoso;
  stop
else (No)
  :Informar datos obligatorios faltantes;
  stop
endif
@enduml
