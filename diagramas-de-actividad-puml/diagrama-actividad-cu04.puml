@startuml
title CU-04 - Consultar Seguimiento de Práctica

|Tutor / Responsable de Empresa|
start
:Acceder a "Consulta de Seguimiento";

|Sistema|
:Mostrar criterios de búsqueda y filtros;

|Tutor / Responsable de Empresa|
:Ingresar uno o más criterios de búsqueda;

|Sistema|
:Validar criterios ingresados;

while (¿Criterios válidos y completos?) is (No)
  :Informar error en los criterios;

  |Tutor / Responsable de Empresa|
  :Corregir criterios de búsqueda;

  |Sistema|
  :Validar criterios ingresados;
endwhile (Sí)

:Recuperar prácticas que cumplen
con las condiciones de búsqueda;

if (¿Existen prácticas encontradas?) then (Sí)
  :Mostrar listado de prácticas encontradas;

  |Tutor / Responsable de Empresa|
  :Seleccionar una práctica;

  |Sistema|
  :Mostrar detalle del seguimiento;

  |Tutor / Responsable de Empresa|
  :Finalizar consulta;

  stop

else (No)
  :Informar que no se encontraron resultados;

  |Tutor / Responsable de Empresa|
  if (¿Modificar filtros?) then (Sí)
    :Modificar criterios de búsqueda;

    |Sistema|
    :Validar criterios ingresados;

    while (¿Criterios válidos y completos?) is (No)
      :Informar error en los criterios;

      |Tutor / Responsable de Empresa|
      :Corregir criterios de búsqueda;

      |Sistema|
      :Validar criterios ingresados;
    endwhile (Sí)

    :Recuperar prácticas que cumplen
    con las condiciones de búsqueda;

    if (¿Existen prácticas encontradas?) then (Sí)
      :Mostrar listado de prácticas encontradas;

      |Tutor / Responsable de Empresa|
      :Seleccionar una práctica;

      |Sistema|
      :Mostrar detalle del seguimiento;

      |Tutor / Responsable de Empresa|
      :Finalizar consulta;
      stop
    else (No)
      :Informar que no se encontraron resultados;
      stop
    endif

  else (No)
    :Finalizar operación;
    stop
  endif
endif

@enduml
