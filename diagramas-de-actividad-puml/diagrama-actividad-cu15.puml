@startuml
title CU-15 - Notificar Alta de Práctica

|Sistema de Gestión de Prácticas UPPA|
start

:Detectar confirmación del registro
exitoso de una nueva práctica;

:Recuperar datos de contacto y nombres
del alumno, tutor y responsable;

if (¿Datos de contacto completos?) then (Sí)
  :Redactar correos utilizando
  plantillas predefinidas;

  |Sistema de Correo Electrónico|
  :Enviar correos simultáneamente
  a los tres destinatarios;

  if (¿Correos enviados correctamente?) then (Sí)
    |Sistema de Gestión de Prácticas UPPA|
    :Registrar en el log de la práctica
    la fecha y hora del envío;

    stop

  else (No)
    :Detectar fallo en el envío;

    |Administrador del Sistema|
    :Recibir notificación del fallo;

    stop
  endif

else (No)
  :Identificar destinatario(s)
  con datos de contacto incompletos;

  :Cancelar envío para el destinatario
  con datos incompletos;

  |Administrador del Sistema|
  :Recibir notificación sobre la falta
  de datos de contacto;

  stop
endif

@enduml