@startuml Diagrama_Actividad_CU06
title CU-06 - Registrar Convenio

|Administrador|
start
:Acceder a la opción Registrar Convenio;

|Sistema|
:Mostrar formulario de alta de convenio;

|Administrador|
label seleccionar_empresa
:Seleccionar empresa;

|Sistema|
:Validar empresa seleccionada;
if (Empresa válida?) then (No)
  :Informar empresa no válida;
  |Administrador|
  goto seleccionar_empresa
else (Si)
endif

|Administrador|
label ingresar_fechas
:Ingresar fecha de inicio y duración o fecha de finalización;

|Sistema|
:Validar consistencia de fechas;
if (Fechas válidas?) then (No)
  :Informar fechas no válidas;
  |Administrador|
  goto ingresar_fechas
else (Si)
endif

|Administrador|
label ingresar_datos
:Ingresar datos obligatorios;

|Sistema|
:Validar datos obligatorios completos;
if (Datos obligatorios válidos?) then (No)
  :Informar datos obligatorios no válidos;
  |Administrador|
  goto ingresar_datos
else (Si)
endif

|Administrador|
:Confirmar registro de convenio;

|Sistema|
:Registrar convenio;
:Asociar a empresa;
:Mostrar mensaje confirmación de registro de convenio;
stop

@enduml
