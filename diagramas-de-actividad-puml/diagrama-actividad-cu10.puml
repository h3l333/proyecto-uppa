@startuml
title CU-10 - Verificar Vigencia del Convenio

|Sistema de Gestión de Prácticas UPPA|
start

:Recibir solicitud de validación
del convenio seleccionado;

:Calcular fecha de vencimiento
del convenio;

:Comparar fecha actual con
fecha de vencimiento;

if (¿Fecha actual anterior al vencimiento?) then (Sí)

  :Verificar tipo de empresa;

  if (¿Empresa del sector público?) then (Sí)

    :Consultar cantidad de alumnos
    con prácticas en curso
    vinculadas al convenio;

    if (¿Alumnos activos < cupo definido?) then (Sí)
      :Confirmar validación del convenio;
    else (No)
      :Bloquear registro;
      :Mostrar mensaje de error
      por cupo excedido;
      stop
    endif

  else (No)
    :Confirmar validación del convenio;
  endif

  :Habilitar continuación del proceso
  de registro de la práctica;
  stop

else (No)
  :Bloquear registro;
  :Mostrar mensaje de error
  por convenio vencido;
  stop
endif
@enduml
